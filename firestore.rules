
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserOfType(userType) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.userType == userType;
    }

    function isAdmin() {
      return isSignedIn() && isUserOfType('admin');
    }

    // --- REGRAS DE COLEÇÕES ---

    // 1. USUÁRIOS E LOGS
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /activityLog/{logId} {
        allow create: if isOwner(userId);
        allow read: if isOwner(userId) || isAdmin();
      }
    }

    // 2. CONFIGURAÇÃO DE CORRETORES
    match /brokers/{brokerId} {
      allow read: if true;
      allow write: if isOwner(brokerId) || isAdmin();
      
      match /{allPaths=**} {
        allow read: if isOwner(brokerId) || isAdmin();
        allow write: if isOwner(brokerId) || isAdmin();
      }
    }

    // 3. CRM LEADS E REDE
    match /leads/{leadId} {
      allow read: if isSignedIn() && (
        resource.data.brokerId == request.auth.uid || 
        resource.data.network.published == true ||
        isAdmin()
      );

      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) || 
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );

      match /networkResponses/{responseId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        // Permitir update se for o autor da resposta OU o dono do lead pai (necessário para Handshake)
        allow update, delete: if isSignedIn() && (
          resource.data.brokerId == request.auth.uid || 
          get(/databases/$(database)/documents/leads/$(leadId)).data.brokerId == request.auth.uid ||
          isAdmin()
        );
      }

      match /statusHistory/{historyId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (get(/databases/$(database)/documents/leads/$(leadId)).data.brokerId == request.auth.uid || isAdmin());
      }
    }

    // 4. IMÓVEIS
    match /properties/{propertyId} {
      allow read, list: if true;
      allow write: if isAdmin() || (isUserOfType('constructor') && request.resource.data.builderId == request.auth.uid);
    }

    match /brokerProperties/{propertyId} {
      allow read, list: if true;
      allow write: if (resource != null && isOwner(resource.data.brokerId)) || 
                   (resource == null && request.resource.data.brokerId == request.auth.uid) || 
                   isAdmin();
    }

    // 5. AGENDA E TAREFAS
    match /events/{eventId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 6. JORNADAS DE VENDA
    match /journeys/{journeyId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );

      match /timeline/{logId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/journeys/$(journeyId)).data.brokerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 7. FINANÇAS
    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 8. INTELIGÊNCIA
    match /personas/{personaId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /marketReports/{reportId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /propertyAnalyses/{analysisId} {
      allow read, write: if isSignedIn();
    }

    // 9. INFRAESTRUTURA E LAYOUTS
    match /layouts/{layoutId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /portfolios/{brokerId} {
      allow read: if true;
      allow write: if isOwner(brokerId) || isAdmin();
    }

    match /plans/{planId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /inviteRequests/{requestId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /domains/{domainName} {
      allow read: if isSignedIn() && (isOwner(resource.data.brokerId) || isAdmin());
      allow write: if isAdmin();
    }

    match /constructors/{constructorId} {
      allow read, list: if true;
      allow write: if isOwner(constructorId) || isAdmin();
    }

    match /radarLists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /announcements/{annId} {
      allow read, list: if isSignedIn();
      // Permitir que usuários criem notificações personalizadas
      allow create: if isSignedIn() && request.resource.data.type in ['notification', 'rede_oraora'];
      allow update, delete: if isAdmin();
    }

    match /corretorMetrics/{userId} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }

    // 10. TICKETS DE SUPORTE
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }
  }
}
