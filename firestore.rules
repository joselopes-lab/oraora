
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserOfType(userType) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.userType == userType;
    }

    function isAdmin() {
      return isSignedIn() && isUserOfType('admin');
    }

    // --- REGRAS DE COLEÇÕES ---

    // 1. USUÁRIOS E LOGS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (resource.data.tenantId == null || request.resource.data.tenantId == resource.data.tenantId) &&
        (resource.data.userType == null || request.resource.data.userType == resource.data.userType) &&
        (resource.data.role == null || request.resource.data.role == resource.data.role) &&
        (resource.data.isAdmin == null || request.resource.data.isAdmin == resource.data.isAdmin)
      );
      allow delete: if isAdmin();

      match /activityLog/{logId} {
        allow create: if isOwner(userId);
        allow read: if isOwner(userId) || isAdmin();
      }
    }

    // 2. CONFIGURAÇÃO DE CORRETORES
    match /brokers/{brokerId} {
      allow read: if true;
      allow write: if isOwner(brokerId) || isAdmin();
      
      match /{allPaths=**} {
        allow read: if isOwner(brokerId) || isAdmin();
        allow write: if isOwner(brokerId) || isAdmin();
      }
    }

    match /brokerCoverage/{brokerId} {
      allow read: if true;
      allow write: if isOwner(brokerId) || isAdmin();
    }

    // 3. CRM LEADS E REDE
    match /leads/{leadId} {
      allow read: if isSignedIn() && (
        resource.data.brokerId == request.auth.uid || 
        resource.data.network.published == true ||
        isAdmin()
      );

      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) || 
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );

      match /networkResponses/{responseId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        // Permitir update se for o autor da resposta OU o dono do lead pai (necessário para Handshake)
        allow update, delete: if isSignedIn() && (
          resource.data.brokerId == request.auth.uid || 
          get(/databases/$(database)/documents/leads/$(leadId)).data.brokerId == request.auth.uid ||
          isAdmin()
        );
      }

      match /statusHistory/{historyId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (get(/databases/$(database)/documents/leads/$(leadId)).data.brokerId == request.auth.uid || isAdmin());
      }
    }

    // 4. IMÓVEIS E PROJETOS
    match /properties/{propertyId} {
      allow read, list: if true;
      allow write: if isAdmin() || (
        isUserOfType('constructor') && (
          // Compatibilidade Legada: Imóveis sem tenantId e com builderId correspondente
          (resource == null && !('tenantId' in request.resource.data) && request.resource.data.builderId == request.auth.uid) ||
          (resource != null && !('tenantId' in resource.data) && resource.data.builderId == request.auth.uid && request.resource.data.builderId == resource.data.builderId) ||
          // Novos Imóveis com tenantId: Validação de tenant, membership em constructors e role (admin ou gerente)
          (
            isSignedIn() &&
            (resource == null || resource.data.tenantId == request.resource.data.tenantId) && // Imutabilidade de tenantId em update
            (resource == null || resource.data.builderId == request.resource.data.builderId) && // Imutabilidade de builderId em update
            request.resource.data.tenantId == getUserData().tenantId &&
            // Verifica se o usuário é membro com role 'admin' ou 'gerente' na construtora do tenant
            get(/databases/$(database)/documents/constructors/$(request.resource.data.tenantId)).data.members != null &&
            get(/databases/$(database)/documents/constructors/$(request.resource.data.tenantId)).data.members.hasAny([
              { 'uid': request.auth.uid, 'role': 'admin' },
              { 'uid': request.auth.uid, 'role': 'gerente' }
            ])
          )
        )
      );
    }

    match /projects/{projectId} {
      allow read, list: if isAdmin() || (isSignedIn() && (
        resource.data.builderId == request.auth.uid ||
        resource.data.isPublished == true ||
        (isUserOfType('constructor') && getUserData().tenantId != null && resource.data.builderId == getUserData().tenantId)
      ));
      allow write: if isAdmin() || (
        isUserOfType('constructor') && (
          (resource == null && (request.resource.data.builderId == request.auth.uid || (getUserData().tenantId != null && request.resource.data.builderId == getUserData().tenantId))) ||
          (resource != null && (resource.data.builderId == request.auth.uid || (getUserData().tenantId != null && resource.data.builderId == getUserData().tenantId)))
        )
      );
    }

    match /brokerProperties/{propertyId} {
      allow read, list: if true;
      allow write: if (resource != null && isOwner(resource.data.brokerId)) || 
                   (resource == null && request.resource.data.brokerId == request.auth.uid) || 
                   isAdmin();
    }

    // 5. AGENDA E TAREFAS
    match /events/{eventId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 6. JORNADAS DE VENDA
    match /journeys/{journeyId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );

      match /timeline/{logId} {
        allow read, write: if isSignedIn();
      }
    }

    // 7. FINANÇAS
    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.brokerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.brokerId == request.auth.uid) ||
        resource.data.brokerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 8. INTELIGÊNCIA
    match /personas/{personaId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /marketReports/{reportId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /propertyAnalyses/{analysisId} {
      allow read, write: if isSignedIn();
    }

    // 9. INFRAESTRUTURA E LAYOUTS
    match /layouts/{layoutId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /portfolios/{brokerId} {
      allow read: if true;
      allow write: if isOwner(brokerId) || isAdmin();
    }

    match /plans/{planId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /inviteRequests/{requestId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /domains/{domainName} {
      allow read: if isSignedIn() && (isOwner(resource.data.brokerId) || isAdmin());
      allow write: if isAdmin();
    }

    match /constructors/{constructorId} {
      // Leitura permitida para Super Admin, dono legado (constructorId == auth.uid),
      // membros do tenant ou se a construtora estiver publicada (para leitura pública básica / vitrine).
      allow read: if isAdmin() || isOwner(constructorId) || 
        (isSignedIn() && resource.data.tenantId == getUserData().tenantId) ||
        (resource.data.isVisibleOnSite != false);
      
      allow list: if isSignedIn();

      // Escrita com proteções robustas para membros, tenantId, ownerId e papéis
      allow write: if isAdmin() || 
        isOwner(constructorId) || 
        (
          isSignedIn() && 
          (
            (resource != null && resource.data.tenantId == getUserData().tenantId) || 
            (request.resource.data.tenantId == constructorId || request.resource.data.id == constructorId)
          ) &&
          (
            // Verifica se o usuário é admin na lista de members da construtora existente ou nova
            resource == null || 
            (
              resource.data.members != null &&
              resource.data.members.hasAny([{ 'uid': request.auth.uid, 'role': 'admin' }])
            ) ||
            (
              resource == null &&
              request.resource.data.members != null &&
              request.resource.data.members.hasAny([{ 'uid': request.auth.uid, 'role': 'admin' }])
            )
          ) &&
          // Imutabilidade de tenantId e ownerId em atualizações
          (
            resource == null || 
            (
              (resource.data.tenantId == null || request.resource.data.tenantId == resource.data.tenantId) &&
              (resource.data.ownerId == null || request.resource.data.ownerId == resource.data.ownerId)
            )
          ) &&
          // Proteções para o array members (em atualizações)
          (
            resource == null ||
            request.resource.data.members == null ||
            (
              // 1. O usuário solicitante não pode remover a si mesmo da lista de membros
              request.resource.data.members.hasAny([{ 'uid': request.auth.uid, 'role': 'admin' }]) &&
              // 2. Validação de estrutura e roles permitidas para cada membro no array
              !(request.resource.data.members.hasAny([
                { 'role': 'superadmin' }, { 'role': 'owner' }, { 'role': 'unauthorized' }
              ]))
            )
          )
        );
    }

    match /radarLists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /announcements/{annId} {
      allow read, list: if isSignedIn();
      // Permitir que usuários criem notificações personalizadas
      allow create: if isSignedIn() && request.resource.data.type in ['notification', 'rede_oraora'];
      allow update, delete: if isAdmin();
    }

    match /corretorMetrics/{userId} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }

    // 10. TICKETS DE SUPORTE
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    // 11. VÍDEOS DE AJUDA
    match /helpVideos/{videoId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // 12. TABELAS DE PREÇOS
    match /priceTables/{tableId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || (
        isUserOfType('constructor') &&
        request.resource.data.tenantId == getUserData().tenantId &&
        get(/databases/$(database)/documents/constructors/$(request.resource.data.tenantId)).data.members != null &&
        get(/databases/$(database)/documents/constructors/$(request.resource.data.tenantId)).data.members.hasAny([
          { 'uid': request.auth.uid, 'role': 'admin' },
          { 'uid': request.auth.uid, 'role': 'gerente' }
        ])
      );

      match /versions/{versionId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || (
          isUserOfType('constructor') &&
          get(/databases/$(database)/documents/priceTables/$(tableId)).data.tenantId == getUserData().tenantId &&
          get(/databases/$(database)/documents/constructors/$(get(/databases/$(database)/documents/priceTables/$(tableId)).data.tenantId)).data.members != null &&
          get(/databases/$(database)/documents/constructors/$(get(/databases/$(database)/documents/priceTables/$(tableId)).data.tenantId)).data.members.hasAny([
            { 'uid': request.auth.uid, 'role': 'admin' },
            { 'uid': request.auth.uid, 'role': 'gerente' }
          ])
        );
      }
    }
  }
}
